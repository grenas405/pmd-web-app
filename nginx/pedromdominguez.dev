# /etc/nginx/sites-available/pedromdominguez.dev
#
# Nginx does the three things it is genuinely better at than an application
# process — TLS termination, compression, and absorbing connection abuse — and
# nothing else. It adds no headers of its own: the Content-Security-Policy and
# the rest are the application's, and are not duplicated here where the two
# copies would inevitably drift apart.
#
#   sudo install -o root -g root -m 0644 nginx/pedromdominguez.dev \
#     /etc/nginx/sites-available/pedromdominguez.dev
#   sudo ln -sf /etc/nginx/sites-available/pedromdominguez.dev /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# The box-wide pieces this depends on live beside it in the repo and are
# installed once, not per site: nginx/snippets/deny-probes.conf (included
# below) and nginx/00-default-drop (the catch-all that closes the connection
# on anything addressed to no server_name at all).
#
# 00-default-drop is a hard dependency, not a nicety. It is parsed first — the
# `00-` prefix is why it is named that — and it is where `listen 443 ssl http2`
# is declared. Protocol options belong to the address:port rather than to a
# server block, so this file's `listen 443;` lines are deliberately bare and
# inherit them. Install this vhost without 00-default-drop and :443 would serve
# plaintext. scripts/deploy.sh always installs both, in that order.
#
# TLS is not Certbot-managed here. The settings below are explicit rather than
# an `include /etc/letsencrypt/options-ssl-nginx.conf`, so that reading this
# file tells you the whole policy, and so a fresh host needs nothing from
# Certbot but the key material itself.

# Connection-level abuse limits, applied before anything reaches Deno.
limit_req_zone $binary_remote_addr zone=pmd_general:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=pmd_contact:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=pmd_conn:10m;

upstream pmd_web {
    server 127.0.0.1:8002 fail_timeout=5s;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name pedromdominguez.dev www.pedromdominguez.dev;

    # Certbot's webroot challenge is the only thing served over plaintext.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://pedromdominguez.dev$request_uri;
    }
}

server {
    # Bare, with no `ssl` or `http2`: those are properties of the socket, and
    # nginx/00-default-drop has already set them for :443. Repeating them here
    # earns a "protocol options redefined" warning and changes nothing.
    listen 443;
    listen [::]:443;
    server_name www.pedromdominguez.dev;

    ssl_certificate     /etc/letsencrypt/live/pedromdominguez.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pedromdominguez.dev/privkey.pem;

    return 301 https://pedromdominguez.dev$request_uri;
}

server {
    listen 443;
    listen [::]:443;
    server_name pedromdominguez.dev;

    ssl_certificate     /etc/letsencrypt/live/pedromdominguez.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pedromdominguez.dev/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;

    # Do not advertise the version to anyone scanning for known Nginx bugs.
    server_tokens off;

    # Scanner traffic for stacks that do not run here, closed with no
    # response — but still logged, because fail2ban reads the access log.
    include snippets/deny-probes.conf;

    # The application refuses bodies over 16 KB itself; this stops an oversized
    # one from being buffered to disk before it ever gets there.
    client_max_body_size 32k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    send_timeout 20s;

    limit_conn pmd_conn 24;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_proxied any;
    gzip_types text/plain text/css text/javascript application/javascript
               application/json application/manifest+json image/svg+xml
               application/xml;

    # Per-site logs. The fail2ban jail matches /var/log/nginx/*access.log, so
    # the name of this file is what puts this site inside the jail.
    access_log /var/log/nginx/pedromdominguez.access.log;
    error_log  /var/log/nginx/pedromdominguez.error.log warn;

    location = /api/contact {
        limit_req zone=pmd_contact burst=5 nodelay;
        include /etc/nginx/proxy_params;
        proxy_pass http://pmd_web;
    }

    location / {
        limit_req zone=pmd_general burst=40 nodelay;

        proxy_pass http://pmd_web;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # $remote_addr, not $proxy_add_x_forwarded_for: this overwrites any
        # header the client sent, so a visitor cannot choose their own
        # rate-limit bucket by forging a hop.
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        proxy_connect_timeout 3s;
        proxy_read_timeout   20s;
        proxy_send_timeout   20s;
        proxy_buffering on;

        # Never cache a response the application marked as private.
        proxy_no_cache $http_authorization;
    }
}
