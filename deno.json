{
  "name": "pmd-web-app",
  "version": "1.0.0",
  "exports": "./main.ts",
  "tasks": {
    "dev": "deno run --watch=src,static,main.ts --allow-net=127.0.0.1 --allow-read=static,var --allow-write=var --allow-env main.ts",
    "start": "deno run --allow-net=127.0.0.1 --allow-read=static,var --allow-write=var --allow-env main.ts",
    "test": "deno test --allow-read=static,var --allow-write=var --allow-env --allow-net=127.0.0.1",
    "check": "deno check main.ts src/**/*.ts tests/**/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "verify": "deno fmt --check && deno lint && deno check main.ts && deno test --allow-read=static,var --allow-write=var --allow-env --allow-net=127.0.0.1"
  },
  "imports": {
    "@std/http": "jsr:@std/http@^1.1.3",
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "@std/media-types": "jsr:@std/media-types@^1.1.0",
    "@std/path": "jsr:@std/path@^1.1.2",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "zod": "jsr:@zod/zod@^4.4.3"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": ["static/vendor"]
  },
  "lint": {
    "exclude": ["static/vendor"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "exclude": ["var", "static/vendor"],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "lib": ["deno.window", "dom", "dom.iterable"]
  }
}
