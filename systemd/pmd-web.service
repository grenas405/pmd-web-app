# /etc/systemd/system/pmd-web.service
#
# The application runs from the checkout, as the login user who deployed it —
# the same arrangement as portfolio-app on this box. There is no copy under
# /srv to drift out of step with git: `git pull` and a restart is the whole
# update, and `systemctl cat pmd-web` names the directory you edit.
#
# The Deno permission flags and the systemd sandbox say the same thing twice,
# from two directions: Deno refuses what the process asks for, and the kernel
# refuses what the process could reach anyway.
#
#   sudo install -o root -g root -m 0644 systemd/pmd-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pmd-web
#
# WorkingDirectory, ConditionPathExists, ReadWritePaths and User all name the
# checkout. scripts/deploy.sh rewrites them for the host it runs on; edit them
# by hand only if you install this file yourself.

[Unit]
Description=pedromdominguez.dev — Deno web application
Documentation=https://github.com/grenas405/pmd-web-app
ConditionPathExists=/home/sysadmin/.local/src/development/pmd-web-app/main.ts
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=sysadmin
Group=sysadmin
WorkingDirectory=/home/sysadmin/.local/src/development/pmd-web-app

Environment=APP_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8002
Environment=PUBLIC_ORIGIN=https://pedromdominguez.dev
Environment=ENABLE_HSTS=true
Environment=TRUST_PROXY=true
Environment=DENO_DIR=/var/cache/pmd-web/deno

# Secrets and per-host overrides, none of them in git. The leading `-` makes
# the file optional: the defaults above stand on their own.
EnvironmentFile=-/etc/pmd-web/pmd-web.env

# Exactly the capabilities the application uses, and no others. Read access is
# the checkout; write access is its var/ directory; the network is one loopback
# interface it can never leave.
ExecStart=/usr/bin/deno run \
  --allow-net=127.0.0.1 \
  --allow-read=static,var \
  --allow-write=var \
  --allow-env=PORT,HOST,PUBLIC_ORIGIN,TRUSTED_ORIGINS,STATIC_DIR,INBOX_PATH,APP_ENV,ENABLE_HSTS,TRUST_PROXY,CONTACT_RATE_LIMIT,CONTACT_RATE_WINDOW_SECONDS \
  --cached-only \
  main.ts

Restart=on-failure
RestartSec=2s
KillSignal=SIGTERM
TimeoutStopSec=20s

# --- sandbox -----------------------------------------------------------------
# ProtectHome=false because the checkout lives under /home; everything else is
# as closed as it was when the code ran out of /srv.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

# The module cache, resolved once at deploy time so --cached-only can hold.
CacheDirectory=pmd-web

# The inbox, and the only writable path in the checkout.
ReadWritePaths=/home/sysadmin/.local/src/development/pmd-web-app/var

# --- limits ------------------------------------------------------------------
LimitNOFILE=8192
MemoryMax=512M
TasksMax=64

# journald captures the JSON access log on stdout; no log files, no rotation.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pmd-web

[Install]
WantedBy=multi-user.target
