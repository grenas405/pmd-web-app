# Optional overrides for pmd-web.service.
# Copy to /etc/pmd-web/pmd-web.env and edit; anything set here wins over the
# Environment= lines in the unit. Nothing in this file belongs in git.
#
#   sudo install -d -m 0755 /etc/pmd-web
#   sudo install -o root -g root -m 0640 systemd/pmd-web.env.example \
#     /etc/pmd-web/pmd-web.env
#
# Every variable is optional and validated at startup by src/config.ts; a
# malformed value stops the service rather than changing how it behaves.

APP_ENV=production
HOST=127.0.0.1
PORT=8002
PUBLIC_ORIGIN=https://pedromdominguez.dev
ENABLE_HSTS=true
TRUST_PROXY=true

# Extra origins accepted on POST, comma separated. Staging hostnames go here.
# TRUSTED_ORIGINS=https://staging.pedromdominguez.dev

# Contact submissions per client per window, and the window in seconds.
# CONTACT_RATE_LIMIT=5
# CONTACT_RATE_WINDOW_SECONDS=600
